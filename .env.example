# Copy this file to .env.local and fill in real values from your Supabase
# project dashboard (Project Settings -> API, and Project Settings -> Database).
# .env.local is gitignored -- never commit real credentials.

# Project Settings -> General -> Reference ID
SUPABASE_PROJECT_REF=

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API -> Project API keys -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API -> Project API keys -> service_role (SECRET -- test
# scripts and admin-only server code use this; it bypasses RLS entirely)
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database -> Connection string -> URI (used by the
# Supabase CLI to link/push migrations, and by any direct-Postgres scripts)
# Use the "Session" pooler connection string, not "Transaction" mode, for
# migration pushes.
SUPABASE_DB_PASSWORD=
